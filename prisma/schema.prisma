datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Demand {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Story {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  mobile    String   @unique
  password  String   // کلمه عبور به صورت هش‌شده ذخیره می‌شود
  lastLogoutAt DateTime? // زمان آخرین لاگ‌اوت ادمین
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}